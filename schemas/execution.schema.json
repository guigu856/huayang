  "required": [
    "render_job_id",
    "spec_sha256",
    "capability_registry_version",
    "project_id",
    "project_path",
    "project_sha256",
    "trace_map_path",
    "trace_map_sha256",
    "render_path",
    "render_sha256",
    "inspection_path",
    "inspection_sha256",
    "inspection_binding_path",
    "inspection_binding_sha256",
    "inspection_passed"
  ],
  "title": "ExecutionManifest",
  "type": "object"
}
