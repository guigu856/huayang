{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "revision",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FreezeRef": {
      "additionalProperties": false,
      "properties": {
        "freeze_id": {
          "minLength": 1,
          "title": "Freeze Id",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_revision": {
          "minimum": 1,
          "title": "Artifact Revision",
          "type": "integer"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        }
      },
      "required": [
        "freeze_id",
        "artifact_id",
        "artifact_revision",
        "artifact_sha256"
      ],
      "title": "FreezeRef",
      "type": "object"
    },
    "ReferenceContextBinding": {
      "additionalProperties": false,
      "properties": {
        "source_report_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "source_report_freeze_ref": {
          "$ref": "#/$defs/FreezeRef"
        },
        "report_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Content Sha256",
          "type": "string"
        },
        "projection_stage": {
          "enum": [
            "creative_direction",
            "resource_preparation",
            "editing_specification"
          ],
          "title": "Projection Stage",
          "type": "string"
        },
        "stage_projection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Stage Projection Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_report_ref",
        "source_report_freeze_ref",
        "report_content_sha256",
        "projection_stage",
        "stage_projection_sha256"
      ],
      "title": "ReferenceContextBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "user_intent": {
      "minLength": 1,
      "title": "User Intent",
      "type": "string"
    },
    "video_type": {
      "minLength": 1,
      "title": "Video Type",
      "type": "string"
    },
    "core_mechanism": {
      "minLength": 1,
      "title": "Core Mechanism",
      "type": "string"
    },
    "production_method": {
      "minLength": 1,
      "title": "Production Method",
      "type": "string"
    },
    "visual_language": {
      "minLength": 1,
      "title": "Visual Language",
      "type": "string"
    },
    "rhythm_and_sound": {
      "minLength": 1,
      "title": "Rhythm And Sound",
      "type": "string"
    },
    "transition_principles": {
      "minLength": 1,
      "title": "Transition Principles",
      "type": "string"
    },
    "asset_and_music_traits": {
      "minLength": 1,
      "title": "Asset And Music Traits",
      "type": "string"
    },
    "viewing_experience": {
      "minLength": 1,
      "title": "Viewing Experience",
      "type": "string"
    },
    "retrieval_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Retrieval Ids",
      "type": "array"
    },
    "reference_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReferenceContextBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "title",
    "user_intent",
    "video_type",
    "core_mechanism",
    "production_method",
    "visual_language",
    "rhythm_and_sound",
    "transition_principles",
    "asset_and_music_traits",
    "viewing_experience",
    "retrieval_ids"
  ],
  "title": "CreativeDirection",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
