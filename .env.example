# 供 yt-dlp 使用的 Netscape 格式 Cookie 文件。
VIDEO_DOWNLOADER_COOKIES_PATH=

# yt-dlp、Playwright 和视频直链请求使用的 HTTP(S) 代理。
VIDEO_DOWNLOADER_PROXY=

# 已运行 Chrome 的 CDP 地址。抖音匿名浏览器被风控时可复用真实浏览器会话。
VIDEO_DOWNLOADER_BROWSER_CDP=

# Agent 默认素材源：Pexels、Pixabay 和无需 Key 的 Archive.org。
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 已抽取但不在 Agent 默认链中的素材源配置。
COVERR_API_KEY=
UNSPLASH_ACCESS_KEY=
VIDEVO_API_KEY=
POND5_DATADOME_COOKIE=
MATERIAL_ACQUISITION_BROWSER_CDP=

# 本地视频剪辑器工程目录；CLI 未传 --root 时使用该值。
VIDEO_EDITOR_ROOT=output/editor/projects

# 字幕字体；未设置时自动查找本机常见中文字体。
VIDEO_EDITOR_FONT_PATH=

# Huayang 项目根目录；源码运行时默认自动定位当前项目。
HUAYANG_PROJECT_ROOT=

# Huayang rules、skills 与 schemas 的资源根目录；默认从安装包定位。
HUAYANG_RESOURCE_ROOT=

# Huayang 的状态、对象库、知识索引和任务产物目录。
HUAYANG_OUTPUT_ROOT=output/plugin

# MCP 可读取的外部媒体根目录；Windows 使用分号分隔多个绝对路径。
HUAYANG_MEDIA_ROOTS=

# 后台管理界面端口；终端执行 huayang 后监听 127.0.0.1。
HUAYANG_ADMIN_PORT=8788
